# 自媒体选题监控中心 · 可选环境变量模板
# 复制本文件为 .env 按需填写即可（也可以直接启动后在页面「系统设置」里配置）

# 唯一对外端口（默认 18910）
MMW_PORT=18910

# OpenAI 兼容大模型接口（支持 DeepSeek / 阿里云百炼千问 / 智谱 / OpenAI / 本机中转站等）
# 例（DeepSeek）：AI_BASE_URL=https://api.deepseek.com/v1  AI_MODEL=deepseek-chat
# 例（阿里云百炼）：AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# 可选：自定义 MediaCrawler（抖音/B站评论深采）目录；留空默认使用 ./tools/MediaCrawler
# MMW_MEDIACRAWLER_DIR=

# 可选：自定义通义听悟脚本目录；留空默认使用仓库内置 ./tools/tingwu-web-batch
# MMW_TINGWU_DIR=

# 可选：自定义 Chromium/Chrome/Edge 可执行文件路径；留空自动探测
# MMW_CHROMIUM_PATH=
